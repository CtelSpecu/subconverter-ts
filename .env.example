# subconverter-worker 环境变量示例
# 复制为 .env (本地) 或 .dev.vars (wrangler dev 本地) 后填入真实值
# 生产建议用 `wrangler secret put` 覆盖敏感项，此文件仅作示例与本地开发

# — Worker 基础 —
API_MODE=true
API_TOKEN=
DEFAULT_URL=
MANAGED_PREFIX=http://127.0.0.1:25500

# — Dashboard 鉴权（单密钥，强随机，必填否则面板 401）—
DASHBOARD_TOKEN=change-me-to-strong-random-32+chars

# — 前端域名白名单（逗号分隔，空即放行 *，非空严格 403）—
# 示例：https://sub.example.com,https://dashboard.example.com
FRONTEND_ALLOWLIST=

# — 限流/日志（可选，面板 /acl /limits /logs 使用，存 KV_ADMIN）—
# 留空走默认值；面板可视化编辑后持久于 KV_ADMIN
# RETENTION_DAYS=180
